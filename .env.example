# Copiá este archivo como .env.local y completá los valores. NUNCA subas .env.local a GitHub.
# Cadena de conexión de Neon (panel de Neon > Connect > Connection string)
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST/NOMBRE_BD?sslmode=require
# Opcional: WhatsApp oficial con código de país, sin + ni espacios (ej. 5493837000000)
NEXT_PUBLIC_WHATSAPP=
# URL pública del sitio (para metadatos al compartir enlaces)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
